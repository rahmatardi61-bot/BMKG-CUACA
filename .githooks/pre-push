#!/bin/sh
# Guard: master is frozen. rahmat-branch is the main branch.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    echo "!! Blocked: push to 'master' is not allowed." >&2
    echo "   Main branch is 'rahmat-branch'. Push there instead." >&2
    exit 1
  fi
done
exit 0